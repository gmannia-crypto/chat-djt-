entrypoint = "README.md"
modules = ["nodejs-22", "python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["chromium", "ffmpeg", "socat"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "node scripts/deploy-build.js"]
run = ["npm", "run", "server:prod"]
publicDir = "dist"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 80

[[ports]]
localPort = 8083
externalPort = 3000

[[ports]]
localPort = 15432
externalPort = 3001

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_openai_ai_integrations:2.0.0", "stripe:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stale-dist"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-persona-images"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "persona-image-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-ai-guard"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo 'Placeholder - use Start Backend and Start Frontend workflows'"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/cleanup-ports.js && npm run server:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_MAX_WORKERS=1 NODE_OPTIONS='--max-old-space-size=2048' EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN npx expo start --port 8081"
waitForPort = 8081

[[workflows.workflow]]
name = "stale-dist"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:stale-dist"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-persona-images"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-persona-images.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "persona-image-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-persona-images.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-ai-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:no-ai-guard"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.development]

[userenv.shared]
CI = "0"
SPORTS_API_KEY = "24db37589d114537a349d154b7a3d040"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
