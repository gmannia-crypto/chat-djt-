{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package && node scripts/postinstall-patch.js",
    "prepare": "git config core.hooksPath .husky || true && node scripts/check-husky-hook.js",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "test:stale-dist": "node scripts/check-dev-no-stale-dist.js",
    "test:persona-check": "node scripts/check-persona-images.test.js",
    "test:no-ai-guard": "npx tsx server/arena-no-ai-guard.test.js && npx tsx server/character-break-gate.test.js",
    "test:no-ai-guard-route": "npx tsx server/arena-no-ai-guard-route.test.js",
    "test:ai-timeouts": "npx tsx lib/ai-turn-retry.test.ts",
    "test:referral-concurrent": "npx tsx server/referral-claim-concurrent.test.js",
    "test:billionaire-validation": "npx tsx server/billionaire-game-validation.test.js",
    "test:billionaire-submit-cooldown": "npx tsx server/billionaire-submit-cooldown.test.js",
    "test:no-ai-deflections": "node scripts/check-no-ai-deflections.js",
    "test:persona-tts": "npx tsx server/persona-tts.test.ts",
    "test:referral-invite-format": "npx tsx lib/referral-invite-format.test.ts",
    "test:bonus-game-comparison": "npx tsx server/bonus-game-comparison.test.js",
    "test:character-break-analytics": "npx tsx server/character-break-analytics.test.js",
    "test:character-break-spike": "npx tsx server/character-break-spike.test.js",
    "test:character-break-alert-delivery": "npx tsx server/character-break-alert-delivery.test.js"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@fal-ai/client": "^1.9.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "archiver": "^8.0.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "expo": "~54.0.33",
    "expo-audio": "^1.1.1",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.11",
    "expo-crypto": "^15.0.8",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "^0.1.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "express": "^5.0.1",
    "fast-xml-parser": "^5.5.6",
    "form-data": "^4.0.5",
    "http-proxy-middleware": "^3.0.5",
    "openai": "^6.18.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.16.3",
    "playwright-core": "^1.58.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.18.5",
    "react-native-purchases": "^9.7.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "sharp": "^0.34.5",
    "stripe": "^20.0.0",
    "stripe-replit-sync": "^1.0.0",
    "tsx": "^4.20.6",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/react": "~19.1.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "minimatch": "10.2.3",
    "@isaacs/brace-expansion": "5.0.1",
    "tar": "7.5.11",
    "flatted": "3.4.2",
    "undici": "6.24.0"
  }
}
