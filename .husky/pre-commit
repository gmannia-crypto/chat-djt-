#!/usr/bin/env sh
#
# Pre-commit hook: run the persona image integrity check before every commit.
# Blocks the commit if any duplicate or mismatched portrait is detected.
#
# To skip in an emergency:  git commit --no-verify
# To update the manifest after an intentional portrait change:
#   node scripts/check-persona-images.js --update
#   git add scripts/persona-image-manifest.json
#

# Collect only staged persona portrait files
STAGED=$(git diff --cached --name-only | grep '^assets/images/persona-.*\.png$')

if [ -z "$STAGED" ]; then
  echo "⚡ No persona images staged — skipping portrait check."
  exit 0
fi

echo "🔍 Checking persona images..."
# shellcheck disable=SC2086
node scripts/check-persona-images.js $STAGED
exit $?
