#!/usr/bin/env sh
#
# Pre-commit hook: run the persona image integrity check before every commit.
# Blocks the commit if any duplicate or mismatched portrait is detected,
# OR if a persona portrait is being deleted.
#
# To skip in an emergency:  git commit --no-verify
# To update the manifest after an intentional portrait change:
#   node scripts/check-persona-images.js --update
#   git add scripts/persona-image-manifest.json
#

# Check for staged *deletions* of persona portrait files first.
DELETED=$(git diff --cached --name-only --diff-filter=D | grep '^assets/images/persona-.*\.png$')

if [ -n "$DELETED" ]; then
  echo ""
  echo "✗ BLOCKED: Staged deletion(s) of persona portrait file(s) detected:"
  echo ""
  for f in $DELETED; do
    echo "    $f"
  done
  echo ""
  echo "  Persona portraits must not be deleted — the app will crash at runtime."
  echo "  If this was intentional, use:  git commit --no-verify"
  echo ""
  exit 1
fi

# Check for staged *renames* of persona portrait files.
# `git mv persona-bannon.png persona_bannon.png` is tracked as a rename (R),
# not a deletion (D), so the deletion guard above won't catch it.
RENAMED_SRC=$(git diff --cached --name-status --diff-filter=R | awk '{ print $2 }' | grep '^assets/images/persona-.*\.png$')

if [ -n "$RENAMED_SRC" ]; then
  echo ""
  echo "✗ BLOCKED: Staged rename(s) of persona portrait file(s) detected:"
  echo ""
  git diff --cached --name-status --diff-filter=R | awk '{ if ($2 ~ /^assets\/images\/persona-.*\.png$/) print "    " $2 " → " $3 }'
  echo ""
  echo "  Persona portraits must not be renamed — the app will crash at runtime."
  echo "  If this was intentional, use:  git commit --no-verify"
  echo ""
  exit 1
fi

# Collect staged additions/modifications of persona portrait files.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '^assets/images/persona-.*\.png$')

if [ -z "$STAGED" ]; then
  echo "⚡ No persona images staged — skipping portrait check."
  exit 0
fi

echo "🔍 Checking persona images..."
# shellcheck disable=SC2086
node scripts/check-persona-images.js $STAGED
exit $?
